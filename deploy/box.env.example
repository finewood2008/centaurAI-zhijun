# 知君「盒子」部署 profile（可选部署目标；软件优先，本文件只是环境变量样例）
# 用法：cp deploy/box.env.example /etc/default/zhijun && set -a && . /etc/default/zhijun && set +a && ./start-backend.sh

# 数据根（所有可变数据：SQLite、索引、记忆投影）。盒子上放持久卷。
CENTAURAI_DATABASE_DATA_ROOT=/var/lib/zhijun/data
# 加密密钥库目录（不随数据备份一起复制）
CENTAUR_SECRET_STORE_DIR=/var/lib/zhijun/secrets

# 运行环境：production 时演示模型（fake）被拒绝启用；Web 访问需要连接票据而不是本机调试模式
MINDOS_RUNTIME_ENV=production
MINDOS_LOCAL_WEB_DEBUG_ACCESS=false

# 模型通道：盒子默认走本机 Ollama；上下文窗口按机器内存调整（4b 模型 8192 起）
ZHIJUN_PROVIDER=
CENTAUR_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
CENTAUR_LOCAL_OLLAMA_MODEL=qwen3:4b
ZHIJUN_LOCAL_NUM_CTX=8192
# 纯本地模式下抽取质量较低：知君会记得更少；开启外部模型请在设置页配置并确认「必要片段出设备」
ZHIJUN_EXTRACTION=1
ZHIJUN_MATERIAL_EVIDENCE=1

# 给其他 Agent 的只读网关（Context Pack / 搜索 / 证据）。默认关；开启后在本机用管理接口签发带 scope 的令牌
MINDOS_AGENT_GATEWAY_ENABLED=false

# 离线：模型权重需预置在 backend/models_cache 等目录
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
