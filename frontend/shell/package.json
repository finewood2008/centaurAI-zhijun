{
  "name": "zhijun-shell",
  "version": "0.1.21",
  "private": true,
  "description": "知君桌面宿主：完整产品界面、受控 IPC 与盒端工作区连接",
  "author": "Zhuhai Qeeshu Technology Co., Ltd.",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "main.js",
  "scripts": {
    "start": "node launch.cjs",
    "start:simulation": "node launch.cjs --simulation",
    "build:provisioning-preload": "esbuild provisioning/preload-formal.mjs --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=provisioning/preload.cjs",
    "pretest": "npm run build:provisioning-preload",
    "acceptance:product": "node scripts/launch-product-stability.cjs",
    "icons:build": "node scripts/build-icons.cjs",
    "test": "node --test tests/*.test.cjs",
    "pretest:windows": "npm run build:provisioning-preload",
    "test:windows": "node scripts/run-windows-tests.cjs",
    "test:e2e": "node tests/electron.e2e.cjs",
    "smoke": "node tests/electron.e2e.cjs",
    "build:desktop": "npm --prefix ../mindos-web run build:desktop",
    "package:prepare:mac-arm64": "node scripts/prepare-macos-package.cjs",
    "package:verify:mac-arm64": "node scripts/verify-macos-package.cjs",
    "package:smoke:mac-arm64": "node scripts/smoke-macos-package.cjs",
    "package:win-x64": "node scripts/build-windows-package.cjs",
    "package:win-x64:unsigned": "node scripts/build-windows-package.cjs --unsigned",
    "package:prepare:win-x64": "node scripts/prepare-windows-package.cjs",
    "package:verify:win-x64": "node scripts/verify-windows-package.cjs",
    "package:smoke:win-x64": "node scripts/smoke-windows-package.cjs",
    "package:verify:test:mac-arm64": "ZHIJUN_PACKAGE_FLAVOR=test node scripts/verify-macos-package.cjs",
    "package:smoke:test:mac-arm64": "ZHIJUN_PACKAGE_FLAVOR=test node scripts/smoke-macos-package.cjs",
    "package:version:bump": "npm version patch --no-git-tag-version",
    "package:mac-arm64": "npm run test && npm --prefix ../mindos-web run test:desktop && npm run test:e2e && npm run build:desktop && npm run package:version:bump && npm run package:prepare:mac-arm64 && electron-builder --config electron-builder.yml --mac dmg zip --arm64 --publish never && npm run package:verify:mac-arm64 && npm run package:smoke:mac-arm64",
    "package:test:mac-arm64": "npm run test && npm --prefix ../mindos-web run test:desktop && npm run test:e2e && npm run build:desktop && npm run package:prepare:mac-arm64 && electron-builder --config electron-builder.test.yml --mac dmg zip --arm64 --publish never && npm run package:verify:test:mac-arm64 && npm run package:smoke:test:mac-arm64"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@peculiar/x509": "1.14.0",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.21.5"
  },
  "dependencies": {
    "@nexusaos/connectivity-contracts": "file:vendor/nexusaos-connectivity-contracts-1.1.0.tgz",
    "@nexusaos/connectivity-electron": "file:vendor/nexusaos-connectivity-electron-1.3.0.tgz",
    "@nexusaos/consumer-contracts": "file:vendor/nexusaos-consumer-contracts-1.0.0.tgz",
    "@nexusaos/device-discovery-contracts": "file:vendor/nexusaos-device-discovery-contracts-1.0.0.tgz",
    "@nexusaos/device-discovery-electron": "file:vendor/nexusaos-device-discovery-electron-1.0.0.tgz",
    "@nexusaos/device-provisioning-electron": "file:vendor/nexusaos-device-provisioning-electron-1.0.0.tgz",
    "@nexusaos/device-provisioning-uni": "file:vendor/nexusaos-device-provisioning-uni-1.0.1.tgz",
    "@nexusaos/local-provisioning-contracts": "file:vendor/nexusaos-local-provisioning-contracts-2.0.0.tgz",
    "@nexusaos/local-provisioning-core": "file:vendor/nexusaos-local-provisioning-core-2.0.0.tgz",
    "@nexusaos/local-provisioning-electron-ble": "file:vendor/nexusaos-local-provisioning-electron-ble-2.0.0.tgz"
  },
  "build": {
    "appId": "com.qeeshu.zhijun",
    "productName": "知君",
    "icon": "assets/centaur.png",
    "mac": {
      "icon": "assets/centaur.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "在你点击录音时使用麦克风，停止后将录音发送到已连接的盒子转为文字。转写结果仅填入输入框，不会自动发送消息。",
        "NSBluetoothAlwaysUsageDescription": "在你点击扫描后发现并连接附近的 AI 盒子，用于读取设备信息和安全配网。"
      }
    },
    "win": {
      "icon": "assets/centaur.png"
    },
    "linux": {
      "icon": "assets/centaur.png"
    }
  }
}
